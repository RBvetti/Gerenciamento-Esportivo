import java.time.LocalDateTime;
import java.util.Objects;

public class Partida {
    private final Long id;
    private final LocalDateTime dataJogo;
    private final Time timeMandante;
    private final Time timeVisitante;
    private int placarMandante;
    private int placarVisitante;
    private StatusPartida status;

    public Partida(Long id, Time timeMandante, Time timeVisitante, LocalDateTime dataJogo) {
        Objects.requireNonNull(timeMandante, "O time mandante é obrigatório.");
        Objects.requireNonNull(timeVisitante, "O time visitante é obrigatório.");
        Objects.requireNonNull(dataJogo, "A data do jogo é obrigatória.");
        if (timeMandante.equals(timeVisitante)) {
            throw new IllegalArgumentException("Um time não pode jogar contra si mesmo.");
        }
        this.id = id;
        this.timeMandante = timeMandante;
        this.timeVisitante = timeVisitante;
        this.dataJogo = dataJogo;
        this.placarMandante = 0;
        this.placarVisitante = 0;
        this.status = StatusPartida.AGENDADO;
    }

    public void iniciarPartida() {
        if (this.status != StatusPartida.AGENDADO) {
            throw new IllegalStateException("A partida não pode ser iniciada no estado atual.");
        }
        this.status = StatusPartida.EM_ANDAMENTO;
    }

    public void atualizarPlacar(int golsMandante, int golsVisitante) {
        if (this.status != StatusPartida.EM_ANDAMENTO) {
            throw new IllegalStateException("Só é possível atualizar placar de jogo em andamento.");
        }
        if (golsMandante < 0 || golsVisitante < 0) {
            throw new IllegalArgumentException("Os gols não podem ser negativos.");
        }
        this.placarMandante = golsMandante;
        this.placarVisitante = golsVisitante;
    }

    public void finalizarPartida(RegraDePontuacao regraDePontuacao) {
        if (this.status != StatusPartida.EM_ANDAMENTO) {
            throw new IllegalStateException("A partida precisa estar em andamento para ser finalizada.");
        }
        Objects.requireNonNull(regraDePontuacao, "A regra de pontuação é obrigatória.");
        this.status = StatusPartida.FINALIZADO;
        regraDePontuacao.calcularPontos(this);
    }

    public Long getId() { return id; }
    public LocalDateTime getDataJogo() { return dataJogo; }
    public Time getTimeMandante() { return timeMandante; }
    public Time getTimeVisitante() { return timeVisitante; }
    public int getPlacarMandante() { return placarMandante; }
    public int getPlacarVisitante() { return placarVisitante; }
    public StatusPartida getStatus() { return status; }

    @Override
    public String toString() {
        return String.format("%s %d x %d %s [%s]",
            timeMandante.getNome(), placarMandante, placarVisitante, timeVisitante.getNome(), status);
    }
}
